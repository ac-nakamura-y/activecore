{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/lumiere.py before-submit",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/lumiere.py stop",
        "timeout": 2592000,
        "loop_limit": null
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/before-submit-meeting-notes-opt-in.py",
        "matcher": "UserPromptSubmit"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-meeting-notes-schedule.sh",
        "timeout": 604800,
        "loop_limit": null
      }
    ]
  }
}
